# Configuración de PostgreSQL
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_guardrail_db
POSTGRES_PORT=5432

# Opcional: URL completa de conexión a Postgres (ej: postgresql://user:password@localhost:5432/dbname)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_guardrail_db

# Umbrales del motor de seguridad
DEFAULT_RISK_THRESHOLD=40
BLOCK_ON_CRITICAL=True
